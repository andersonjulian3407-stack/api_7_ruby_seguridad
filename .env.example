# Variables de entorno — NUNCA subir el archivo .env real al repositorio
# Copie este archivo como .env y complete los valores

# ── Base de datos (SQL Server) ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=1433
DB_NAME=api_ruby_db
DB_USERNAME=sa
DB_PASSWORD=TuPasswordSegura

# ── JWT (Módulo 5) ─────────────────────────────────────────────────────────
# OBLIGATORIO: Cambie esta clave en producción. Mínimo 32 caracteres aleatorios.
# Genere con: ruby -e "require 'securerandom'; puts SecureRandom.hex(32)"
JWT_SECRET_KEY=cambie_esto_por_una_clave_segura_de_al_menos_32_caracteres

# ── Contraseñas iniciales de seeds ────────────────────────────────────────
ADMIN_PASSWORD=Admin@1234!
USER_PASSWORD=User@1234!

# ── Rails ─────────────────────────────────────────────────────────────────
RAILS_ENV=development
SECRET_KEY_BASE=cambie_esto_tambien
